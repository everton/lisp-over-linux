(require 'org)
(defun hidden ()
  (let (out) (save-excursion (goto-char (point-min)) (let ((n 1))
    (while (not (eobp)) (when (invisible-p (point)) (push n out)) (forward-line 1) (setq n (1+ n)))))
    (nreverse out)))
(defun rep (tag) (princ (format "%s: %S\n" tag (hidden))))
(find-file "fx.org") (org-mode) (org-fold-show-all) 
(princ (format "headlines: %S\n" (org-map-entries (lambda () (list (line-number-at-pos) (org-current-level) (org-get-heading t t t t))))))
(goto-char (point-min)) (forward-line 2)  ; * A
(setq last-command nil) (org-cycle) (rep "A tab1")
(setq last-command 'org-cycle) (setq this-command 'org-cycle) (org-cycle) (rep "A tab2")
(setq last-command 'org-cycle) (org-cycle) (rep "A tab3")
(setq last-command nil) (org-cycle) (rep "A tab4 after other")
(org-fold-show-all)
(setq last-command nil this-command 'org-cycle-global) (org-cycle-global) (rep "S-TAB1")
(setq last-command 'org-cycle-global) (org-cycle-global) (rep "S-TAB2")
(setq last-command 'org-cycle-global) (org-cycle-global) (rep "S-TAB3")
(org-fold-show-all) (goto-char (point-min)) (forward-line 4) ; ** A1
(setq last-command nil) (org-cycle) (rep "A1 tab1")
(setq last-command 'org-cycle) (org-cycle) (rep "A1 tab2")
(org-fold-show-all) (goto-char (point-min)) (re-search-forward "^\\* B") (beginning-of-line)
(setq last-command nil) (org-cycle) (rep "B tab1")
(setq last-command 'org-cycle) (org-cycle) (rep "B tab2")
(setq last-command 'org-cycle) (org-cycle) (rep "B tab3")
