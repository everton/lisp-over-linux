(require 'org)
(defmacro try (&rest b) `(condition-case e (progn ,@b) (error (princ (format "ERR %S " e)))))
(defun at (l) (goto-char (point-min)) (forward-line (1- l)))
(defun go (tag l fn) (at l) (try (funcall fn 1)) (princ (format "%s from %d -> %d\n" tag l (line-number-at-pos))))
(with-temp-buffer
  (insert-file-contents "fx.org") (org-mode) (org-fold-show-all)
  (go "C-c C-n" 4 'org-next-visible-heading)
  (go "C-c C-n" 3 'org-next-visible-heading)
  (go "C-c C-p" 6 'org-previous-visible-heading)
  (go "C-c C-p" 5 'org-previous-visible-heading)
  (go "C-c C-f" 5 'org-forward-heading-same-level)
  (go "C-c C-f" 6 'org-forward-heading-same-level)
  (go "C-c C-f" 8 'org-forward-heading-same-level)
  (go "C-c C-b" 9 'org-backward-heading-same-level)
  (go "C-c C-b" 8 'org-backward-heading-same-level)
  (go "C-c C-b" 5 'org-backward-heading-same-level)
  (go "C-c C-u" 6 'outline-up-heading)
  (go "C-c C-u" 5 'outline-up-heading)
  (go "C-c C-u" 4 'outline-up-heading)
  (go "C-c C-u" 2 'outline-up-heading))
