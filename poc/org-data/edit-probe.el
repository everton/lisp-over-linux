(require 'org)
(defun dump (tag) (princ (format "== %s (point line %d col %d)\n%s" tag (line-number-at-pos) (current-column) (buffer-string))))
(defun fresh () (erase-buffer) (insert-file-contents "fx2.org") (org-mode) (goto-char (point-min)))
(defmacro try (&rest b) `(condition-case e (progn ,@b) (error (princ (format "== ERROR %S\n" e)))))
(with-temp-buffer
  (try (fresh) (forward-line 6) (org-move-subtree-down) (dump "C down (last)"))
  (try (fresh) (forward-line 5) (org-move-subtree-up) (dump "B1 up (first child)"))
  (try (fresh) (forward-line 3) (org-demote-subtree) (dump "B demote subtree"))
  (try (fresh) (forward-line 3) (org-do-demote) (dump "B demote heading"))
  (try (fresh) (forward-line 5) (org-do-promote) (dump "B1 promote heading"))
  (try (fresh) (org-do-promote) (dump "A promote level1"))
  (try (fresh) (forward-line 3) (end-of-line) (org-meta-return) (insert "NEW") (dump "M-RET at eol of B"))
  (try (fresh) (forward-line 3) (forward-char 1) (org-meta-return) (insert "NEW") (dump "M-RET in stars of B"))
  (try (fresh) (forward-line 3) (forward-char 3) (org-meta-return) (insert "NEW") (dump "M-RET mid title B"))
  (try (fresh) (forward-line 4) (forward-char 2) (org-meta-return) (insert "NEW") (dump "M-RET mid body of B"))
  (try (fresh) (forward-line 1) (end-of-line) (org-meta-return) (insert "NEW") (dump "M-RET eol body A"))
  (try (fresh) (forward-line 3) (org-todo) (dump "C-c C-t 1") (org-todo) (dump "C-c C-t 2") (org-todo) (dump "C-c C-t 3")))
