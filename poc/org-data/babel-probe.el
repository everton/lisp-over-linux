;;; Where Org Babel writes a block's results (C-c C-c), for poc/org-test.lisp's
;;; "source blocks and their results". Emacs Lisp blocks stand in for Lisp ones:
;;; ob-lisp needs SLIME, and what is probed here is placement, not evaluation.
(require 'org) (require 'ob-emacs-lisp)
(setq org-confirm-babel-evaluate nil)
(defun run (tag text line)
  (with-temp-buffer
    (insert text) (org-mode) (goto-char (point-min)) (forward-line line)
    (org-ctrl-c-ctrl-c)
    (princ (format "== %s\n%s|END\n" tag (buffer-string)))))
(run "new, text follows" "* A\n#+begin_src emacs-lisp\n(+ 1 2)\n#+end_src\nafter\n" 2)
(run "new, at the end" "#+begin_src emacs-lisp\n(+ 1 2)\n#+end_src" 1)
(run "new, blank lines follow" "#+begin_src emacs-lisp\n(+ 1 2)\n#+end_src\n\n\n\n* next\n" 1)
(run "replaces fixed lines" "#+begin_src emacs-lisp\n(+ 1 2)\n#+end_src\n\n#+RESULTS:\n: 99\n: 98\n\nafter\n" 1)
(run "replaces, text right after" "#+begin_src emacs-lisp\n(+ 1 2)\n#+end_src\n#+RESULTS:\n: old\nafter\n" 1)
(run "replaces an example block" "#+begin_src emacs-lisp\n(+ 1 2)\n#+end_src\n#+RESULTS:\n#+begin_example\nold\n#+end_example\nafter\n" 1)
(run "replaces a table" "#+begin_src emacs-lisp\n(+ 1 2)\n#+end_src\n\n#+RESULTS:\n| 1 | 2 |\n| 3 | 4 |\nafter\n" 1)
(run "replaces a drawer" "#+begin_src emacs-lisp\n(+ 1 2)\n#+end_src\n\n#+RESULTS:\n:results:\nx\n:end:\nafter\n" 1)
(run "keeps a paragraph" "#+begin_src emacs-lisp\n(+ 1 2)\n#+end_src\n\n#+RESULTS:\nnot a result\n" 1)
(run "on the #+begin_src line" "#+begin_src emacs-lisp\n(make-string 3 ?x)\n#+end_src\n" 0)
(run "two lines" "#+begin_src emacs-lisp\n\"two\nlines\"\n#+end_src\n" 1)
(run "a blank line inside" "#+begin_src emacs-lisp\n\"a\\n\\nb\"\n#+end_src\n" 2)
(run "a trailing newline" "#+begin_src emacs-lisp\n\"x\n\"\n#+end_src\n" 1)
(run "nil" "#+begin_src emacs-lisp\nnil\n#+end_src\n" 1)
(run "9 lines" "#+begin_src emacs-lisp\n(mapconcat #'number-to-string (number-sequence 1 9) \"\\n\")\n#+end_src\n" 1)
(run "10 lines" "#+begin_src emacs-lisp\n(mapconcat #'number-to-string (number-sequence 1 10) \"\\n\")\n#+end_src\n" 1)
(run "escaped in an example" "#+begin_src emacs-lisp\n(mapconcat #'identity '(\"* h\" \"#+x\" \",* c\" \"a\" \"b\" \"c\" \"d\" \"e\" \"f\" \"g\") \"\\n\")\n#+end_src\n" 1)
(run "named" "#+name: foo\n#+begin_src emacs-lisp\n(+ 1 2)\n#+end_src\n" 2)
(run "indented" "  #+begin_src emacs-lisp\n  (+ 1 2)\n  #+end_src\n" 1)
(run ":results output" "#+begin_src emacs-lisp :results output\n(princ \"hi\\nthere\") 5\n#+end_src\n" 1)
(run ":results silent" "#+begin_src emacs-lisp :results silent\n(+ 1 1)\n#+end_src\n" 1)
(run ":results verbatim" "#+begin_src emacs-lisp :results verbatim\n'(1 2)\n#+end_src\n" 1)
