# gen_init_cpio description for the SBCL-as-init rootfs (separate initrd).
# Build it by hand into a .cpio with the kernel's usr/gen_init_cpio.

# --- directories: mount points + library search paths + /tmp ---
dir  /dev                       0755 0 0
dir  /proc                      0755 0 0
dir  /sys                       0755 0 0
dir  /tmp                       1777 0 0
dir  /sbin                      0755 0 0
dir  /lib64                     0755 0 0
dir  /usr                       0755 0 0
dir  /usr/lib                   0755 0 0
dir  /usr/lib/x86_64-linux-gnu  0755 0 0
# storage (doc/storage.org): the config preinit reads, the host disk's private
# mount point, and the ONE place the host tree crosses into ours.
dir  /etc                       0755 0 0
dir  /mnt                       0755 0 0
dir  /mnt/host                  0755 0 0
dir  /home                      0755 0 0

# --- device nodes: stdio works even before devtmpfs is mounted ---
nod  /dev/console 0600 0 0 c 5 1
nod  /dev/null    0666 0 0 c 1 3
nod  /dev/tty     0666 0 0 c 5 0

# Source paths below are RELATIVE to the project root — build.sh runs
# gen_init_cpio from there, so no machine-specific absolute path appears here.

# --- the C preinit is /init (mounts fs incl. /tmp, then execs the Lisp) ---
file /init      initramfs/preinit   0755 0 0

# --- lol-ct: runs a command inside the host's own Debian, in its own user, mount,
#     pid and uts namespaces (doc/containers.org). Static musl, like /init. ---
file /sbin/lol-ct initramfs/lol-ct  0755 0 0

# --- who to become and which disk to mount (generated by build.sh) ---
file /etc/lol.conf initramfs/lol.conf 0644 0 0

# --- name resolution for glibc programs (doc/networking.org §2c). /etc/resolv.conf
#     is NOT here: preinit creates it at boot and gives it to the user, and
#     dns.lisp writes it from each DHCP lease. ---
file /etc/hosts         initramfs/etc/hosts         0644 0 0
file /etc/nsswitch.conf initramfs/etc/nsswitch.conf 0644 0 0

# --- the SBCL standalone image (supervisor + worker in one binary) ---
file /sbin/lisp initramfs/lisp-init 0755 0 0

# --- the Land-of-Lisp alien sprite: raw RGBA, 256x150, top-to-bottom ---
# (generated from lisplogo_alien_256.png: `convert alien256.png -depth 8 RGBA:alien.rgba`)
file /alien.rgba initramfs/alien.rgba 0644 0 0

# --- previews: stb_image as a shared object (JPEG/PSD/HDR), loaded lazily by
#     lol.image (doc/previews.org). Needs only libc + libm, shipped below. ---
dir  /usr/lib/lol                0755 0 0
file /usr/lib/lol/libstbi.so     poc/out/libstbi.so 0755 0 0

# --- the code browser's fonts (doc/fonts.org) ---
# the outline font, a monospace .ttf build.sh copies from the BUILD HOST (never committed;
# empty when the host had none, and then the image falls back to the bitmap below)
dir  /usr/share                  0755 0 0
dir  /usr/share/lol              0755 0 0
file /usr/share/lol/mono.ttf     initramfs/mono.ttf 0644 0 0
# the fallback: Cozette (MIT), our 6x15 .lolf bitmap blob (poc/README)
file /cozette.lolf poc/cozette.lolf 0644 0 0

# --- glibc runtime the SBCL binary needs (exact paths the loader expects) ---
file /lib64/ld-linux-x86-64.so.2         /usr/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 0755 0 0
file /usr/lib/x86_64-linux-gnu/libc.so.6 /usr/lib/x86_64-linux-gnu/libc.so.6            0755 0 0
file /usr/lib/x86_64-linux-gnu/libm.so.6 /usr/lib/x86_64-linux-gnu/libm.so.6            0755 0 0
